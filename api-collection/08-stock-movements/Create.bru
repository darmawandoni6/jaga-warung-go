meta {
  name: Create
  type: http
  seq: 1
}


post {
  url: {{base_url}}/api/v1/stock-movements
  body: json
  auth: bearer
}


headers {
  Content-Type: application/json
}


body:json {
  {
    "product_barcode": "{{product_barcode}}",
    "type": "restock",
    "quantity": 10,  "total_cost": 12000,
    "note": "restock via collection"
  }
}


auth:bearer {
  token: {{access_token}}
}


tests {
  test('movement created', () => {
    expect(res.status).to.equal(201);
  });
  if (res.status === 201) {
    bru.setVar('movement_id', res.body.data.id);
  }
}

