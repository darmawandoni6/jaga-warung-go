meta {
  name: Create
  type: http
  seq: 1
}

post {
  url: {{base_url}}/api/v1/debt-payments
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "debt_id": "{{debt_id}}",
    "amount": 40000,
    "method": "cash",
    "note": "cicilan 1",
    "create_cash_flow": true
  }
}

vars:pre-request {
  debt_id: 11245867-8b77-4edc-bf8e-6561585f798a
}

tests {
  test('payment created', () => {
    expect(res.status).to.equal(201);
  });
  if (res.status === 201) {
    bru.setVar('payment_id', res.body.data.payment.id);
  }
}
