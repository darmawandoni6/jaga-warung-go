meta {
  name: Create
  type: http
  seq: 1
}

post {
  url: {{base_url}}/api/v1/transactions
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "total_amount": 4000,
    "payment_amount": 5000,
    "change_amount": 1000,
    "items": [
      {
        "product_barcode": "{{product_barcode}}",
        "product_name": "Kopi Sachet",
        "sell_price": 2000,
        "quantity": 2
      }
    ]
  }
}

vars:pre-request {
  product_barcode: 8990000000033
}

tests {
  test('sale created', () => {
    expect(res.status).to.equal(201);
  });
  if (res.status === 201) {
    bru.setVar('transaction_id', res.body.data.id);
  }
}
