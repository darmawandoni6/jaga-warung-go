meta {
  name: Create
  type: http
  seq: 1
}


post {
  url: {{base_url}}/api/v1/categories
  body: json
  auth: bearer
}


headers {
  Content-Type: application/json
}


body:json {
  {
    "name": "Snack"
  }
}


auth:bearer {
  token: {{access_token}}
}


tests {
  test('category created', () => {
    expect(res.status).to.equal(201);
  });
  if (res.status === 201) {
    bru.setVar('category_id', res.body.data.id);
  }
}

