# Copy to .env and customize per deployment. Kept out of source control.
DATABASE_URL=host=localhost user=postgres password=postgres dbname=jaga_warung port=5432 sslmode=disable TimeZone=Asia/Jakarta
PORT=8080
LOG_LEVEL=info
JWT_SECRET=dev-only
ACCESS_TTL=15m
REFRESH_TTL=720h
ADMIN_PHONE=081234567890
ADMIN_PASSWORD=devsecret123
# Host-side broker. The compose api/worker services use kafka:9092 directly.
KAFKA_BROKERS=localhost:9094
KAFKA_GROUP_ID=jaga-warung-worker
DEBUG=true