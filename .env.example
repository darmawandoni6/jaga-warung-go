# Copy to .env and customize per deployment. Never commit .env.

# Local host database. Compose overrides this with its internal PostgreSQL DSN.
DATABASE_URL=host=localhost user=postgres password=postgres dbname=jaga_warung port=5432 sslmode=disable TimeZone=Asia/Jakarta
PORT=8080
LOG_LEVEL=info
DEBUG=false

# Required by API startup.
JWT_SECRET=replace-with-random-secret
ADMIN_PHONE=081234567890
ADMIN_PASSWORD=replace-with-admin-password
ACCESS_TTL=15m
REFRESH_TTL=720h

# Host-side broker. Compose api/worker services use kafka:9092 directly.
KAFKA_BROKERS=localhost:9094
KAFKA_GROUP_ID=jaga-warung-worker

# Midtrans Snap/Core API. Leave server key empty to disable payments locally.
MIDTRANS_ENV=sandbox
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
